{
  "name": "biu-player",
  "version": "0.5.2",
  "description": "基于 B 站公开接口的桌面音乐播放器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer/api.js && node --check renderer/playback-session.js && node --check renderer/app.js",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "com.biu.player",
    "productName": "Biu Player",
    "files": [
      "main.js",
      "preload.js",
      "lyric-preload.js",
      "lyric.html",
      "renderer/**",
      "vendor/**"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": ["dmg", "zip"],
      "icon": "build/icon.png",
      "hardenedRuntime": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "shazamio-core": "^1.3.1"
  }
}
