{
  "name": "biu-player",
  "version": "0.5.4",
  "description": "基于 B 站公开接口的桌面音乐播放器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "mobile": "node mobile/server.js",
    "dev:web": "vite",
    "build:web": "vite build",
    "start:web": "BIU_WEB_UI=1 electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer/api.js && node --check renderer/playback-session.js && node --check renderer/app.js",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "com.biu.player",
    "productName": "Biu Player",
    "files": [
      "main.js",
      "preload.js",
      "lyric-preload.js",
      "lyric.html",
      "renderer/**",
      "vendor/**"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "notarize": false
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shazamio-core": "^1.3.1"
  }
}
