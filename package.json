{
  "name": "biu-player",
  "version": "0.6.2",
  "description": "基于 B 站公开接口的桌面音乐播放器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "mobile": "node mobile/server.js",
    "dev:web": "vite",
    "build:web": "vite build",
    "start:web": "BIU_WEB_UI=1 electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer/api.js && node --check renderer/playback-session.js && node --check renderer/app.js && node --check video-cloud-sync.js && node --check cloud-video-bili.js && node --check cloud-video-runtime.js && node --check renderer/video-cloud-settings.js",
    "test": "node --test test/*.test.cjs",
    "dist": "npm run build:web && npm run build:cloud && electron-builder --mac",
    "dist:win": "npm run build:web && npm run build:cloud && electron-builder --win --x64",
    "build:cloud": "node scripts/build-cloud-runtime.cjs"
  },
  "build": {
    "appId": "com.biu.player",
    "productName": "Biu Player",
    "files": [
      "main.js",
      "lan-sync.js",
      "preload.js",
      "lyric-preload.js",
      "lyric.html",
      "renderer/**",
      "web-dist/**",
      "vendor/**",
      "video-cloud-sync.js",
      "cloud-video-runtime.js",
      "cloud-video-bili.js",
      "app-updates.js"
    ],
    "mac": {
      "category": "public.app-category.music",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "自动连接同一局域网内登录相同账号的 Biu Player 手机端，同步我喜欢和歌单。",
        "NSBonjourServices": [
          "_biu-sync._tcp"
        ]
      },
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "signIgnore": [
        "\\.lproj/locale\\.pak$"
      ],
      "notarize": false,
      "artifactName": "Biu-Player-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "Biu-Player-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Biu-Player-${version}-windows-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "cloud-video",
        "to": "cloud-video",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.md"
        ]
      },
      {
        "from": "dist/cloud-runtime",
        "to": "cloud-video/runtime"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Lyle-xub",
        "repo": "biu-player",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shazamio-core": "^1.3.1"
  }
}
