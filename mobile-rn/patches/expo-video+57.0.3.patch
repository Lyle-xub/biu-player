+internal struct BiuSystemSeekEvent: Record {
+  @Field var sourceTime: Double = 0
+  @Field var mediaKey: String = ""
+  @Field var segmentStart: Double = 0
+  @Field var segmentDuration: Double? = nil
+}
+
+// AVPlayer uses source time; system media controls use the selected song's time.
+struct BiuPlaybackWindow {
+  let start: Double
+  let duration: Double?
+
+  init(sourceDuration: Double, segmentStart: Double?, segmentEnd: Double?) {
+    let sourceEnd = sourceDuration.isFinite && sourceDuration > 0 ? sourceDuration : nil
+    if let from = segmentStart, let to = segmentEnd,
+      from.isFinite, to.isFinite, from >= 0, to > from,
+      min(to, sourceEnd ?? to) > from {
+      start = from
+      duration = min(to, sourceEnd ?? to) - from
+    } else {
+      start = 0
+      duration = sourceEnd
+    }
+  }
+
+  func elapsed(_ sourceTime: Double) -> Double {
+    guard sourceTime.isFinite else { return 0 }
+    return min(duration ?? .infinity, max(0, sourceTime - start))
+  }
+
+  func sourceTime(_ elapsed: Double) -> Double {
+    start + min(duration ?? .infinity, max(0, elapsed.isFinite ? elapsed : 0))
+  }
+}
