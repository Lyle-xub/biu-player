+package expo.modules.video.playbackService
+
+import androidx.media3.common.ForwardingPlayer
+import androidx.media3.common.Player
+import expo.modules.video.player.VideoPlayer
+
+/** Exposes app-queue navigation as standard Android media commands. */
+class RemoteCommandPlayer(private val videoPlayer: VideoPlayer) : ForwardingPlayer(videoPlayer.player) {
+  override fun getAvailableCommands(): Player.Commands = super.getAvailableCommands()
+    .buildUpon()
+    .add(Player.COMMAND_SEEK_TO_PREVIOUS)
+    .add(Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM)
+    .add(Player.COMMAND_SEEK_TO_NEXT)
+    .add(Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM)
+    .build()
+
+  override fun isCommandAvailable(command: Int): Boolean = when (command) {
+    Player.COMMAND_SEEK_TO_PREVIOUS,
+    Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM,
+    Player.COMMAND_SEEK_TO_NEXT,
+    Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM -> true
+    else -> super.isCommandAvailable(command)
+  }
+
+  override fun hasPreviousMediaItem(): Boolean = true
+
+  override fun hasNextMediaItem(): Boolean = true
+
+  override fun seekToPrevious() = videoPlayer.emitRemotePrevious()
+
+  override fun seekToPreviousMediaItem() = videoPlayer.emitRemotePrevious()
+
+  override fun seekToNext() = videoPlayer.emitRemoteNext()
+
+  override fun seekToNextMediaItem() = videoPlayer.emitRemoteNext()
+}
