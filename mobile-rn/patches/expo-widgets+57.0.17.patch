+import SwiftUI
+import UIKit
+
+// Folia Midnight Default: src/services/baseThemes.ts at reference commit
+// 08fc072f803fa9059792069556ce763aa7e6f437.
+public enum BiuMonetPalette {
+  public static let background = UIColor(red: 9 / 255, green: 9 / 255, blue: 11 / 255, alpha: 1)
+  public static let primary = UIColor(red: 244 / 255, green: 244 / 255, blue: 245 / 255, alpha: 1)
+  public static let primaryColor = Color(red: 244 / 255, green: 244 / 255, blue: 245 / 255)
+}
+
+struct BiuLyricPage {
+  let text: String
+  let from: Double
+  let to: Double
+  let advance: Double
+}
+
+// Foundation's word segmentation handles Chinese and mixed-language lyrics.
+// Keep punctuation/spacing with its preceding word, and carry the unplayed
+// right-hand context into the next page instead of dropping it at the cut.
+func biuLyricPages(_ text: String, viewport: Double, measure: (String) -> Double) -> [BiuLyricPage] {
+  guard !text.isEmpty, viewport > 0 else { return [.init(text: text, from: 0, to: 1, advance: 1)] }
+  var starts: [String.Index] = []
+  text.enumerateSubstrings(in: text.startIndex..<text.endIndex, options: .byWords) { _, range, _, _ in
+    starts.append(range.lowerBound)
+  }
+  let boundaries = [text.startIndex] + Array(starts.dropFirst()) + [text.endIndex]
+  let offsets = boundaries.map { measure(String(text[..<$0])) }
+  let total = max(1, offsets.last ?? 0)
+  var pages: [BiuLyricPage] = []
+  var first = 0
+  while first < boundaries.count - 1 {
+    var end = first + 1
+    while end + 1 < boundaries.count && measure(String(text[boundaries[first]..<boundaries[end + 1]])) <= viewport { end += 1 }
+    var next = first + 1
+    while next + 1 <= end && measure(String(text[boundaries[first]..<boundaries[next + 1]])) <= viewport * 0.75 { next += 1 }
+    if end == boundaries.count - 1 { next = end }
+    pages.append(.init(text: String(text[boundaries[first]..<boundaries[end]]),
+      from: offsets[first] / total, to: offsets[end] / total, advance: offsets[next] / total))
+    if end == boundaries.count - 1 { break }
+    first = next
+  }
+  return pages
+}
+
+func biuLyricPageIndex(_ pages: [BiuLyricPage], progress: Double) -> Int {
+  pages.firstIndex(where: { progress < $0.advance }) ?? max(0, pages.count - 1)
+}
+
+public struct BiuMonetLine: Decodable, Equatable {
+  public var id: String
+  public var text: String
+  public var from: Double
+  public var to: Double
+  public var words: [[Double]]
+}
+
+public struct BiuLyricsFrame: Decodable {
+  public var slots: [BiuMonetLine?]?
+  public var activeSlot: Int?
+  public var previousLyric: String?
+  public var position: Double?
+  public var updatedAt: Double?
+  public var playing: Bool?
+  public var clockRevision: String?
+  public var clockAnchor: Double?
+  public var lockScreenLyrics: Bool?
+  public var dynamicIslandLyrics: Bool?
+  public var coverColor: [Double]?
+
+  public var backgroundColor: UIColor {
+    guard let rgb = coverColor, rgb.count >= 3, rgb.prefix(3).allSatisfy(\.isFinite) else {
+      return BiuMonetPalette.background
+    }
+    let scale = min(0.52, 0.24 / max(0.001, rgb.prefix(3).max() ?? 0))
+    let channels = rgb.prefix(3).map { CGFloat(min(0.26, 0.012 + max(0, $0) * scale)) }
+    return UIColor(red: channels[0], green: channels[1], blue: channels[2], alpha: 1)
+  }
+
+  public static func decode(_ json: String) -> Self {
+    (try? JSONDecoder().decode(Self.self, from: Data(json.utf8))) ?? Self()
+  }
+
+  public func line(_ slot: Int) -> BiuMonetLine? {
+    guard let slots, slots.indices.contains(slot) else { return nil }
+    return slots[slot]
+  }
+
+  public func time(at date: Date) -> Double {
+    // ActivityKit may delay an update well beyond the requested cadence. A
+    // short cap leaves the sweep permanently behind and eventually frozen.
+    let elapsed = playing == true ? max(0, date.timeIntervalSince1970 - (updatedAt ?? date.timeIntervalSince1970)) : 0
+    return (position ?? 0) + elapsed
+  }
+
+  public var animationID: String { "\(clockRevision ?? ""):\(playing == true)" }
+}
+
+// A display-link clock, corrected only for seeks, state changes or real drift.
+// Replacing the anchor on every JS sample rewound the glow between samples.
+public struct BiuLyricsClock {
+  private var anchor = 0.0
+  private var anchoredAt = Date.distantPast
+  private var sampledAt = Date.distantPast
+  private var revision = ""
+  private var playing = false
+
+  public init() {}
+
+  public mutating func update(_ frame: BiuLyricsFrame, at date: Date) {
+    let sample = frame.time(at: date)
+    if frame.animationID != revision || !playing || abs(sample - time(at: date)) > 0.35 {
+      anchor = sample
+      anchoredAt = date
+    }
+    sampledAt = date
+    revision = frame.animationID
+    playing = frame.playing == true
+  }
+
+  public func time(at date: Date) -> Double {
+    guard playing else { return anchor }
+    // PiP owns a 30 FPS display link while it is visible. Its clock must keep
+    // moving between JS samples and while the app is backgrounded.
+    return anchor + max(0, date.timeIntervalSince(anchoredAt))
+  }
+}
