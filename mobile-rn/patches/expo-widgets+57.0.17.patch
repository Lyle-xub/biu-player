+// The desktop renderer's measured-grapheme sweep and word-local lingering glow.
+// Shared by SwiftUI Live Activities and the UIKit PiP renderer.
+public struct BiuMonetWord {
+  public let text: String
+  public let x: CGFloat
+  public let width: CGFloat
+  public let offsets: [CGFloat]
+  public let graphemeTimings: [(from: Double, to: Double)]
+  public let from: Double
+  public let to: Double
+  public var timed: Bool { from >= 0 && to > from }
+
+  public func filledWidth(at time: Double) -> CGFloat {
+    guard timed, time > from else { return 0 }
+    if time >= to { return width }
+
+    let timingCount = min(graphemeTimings.count, offsets.count - 1)
+    if timingCount > 0 {
+      for index in 0..<timingCount {
+        let timingFrom = max(from, graphemeTimings[index].from)
+        let timingTo = max(timingFrom, graphemeTimings[index].to)
+        let startWidth = offsets[index]
+        let endWidth = offsets[index + 1]
+        if time < timingFrom { return startWidth }
+        if time <= timingTo {
+          let progress = (time - timingFrom) / max(0.001, timingTo - timingFrom)
+          return startWidth + (endWidth - startWidth) * CGFloat(progress)
+        }
+      }
+      return offsets[timingCount]
+    }
+
+    let cursor = (time - from) / (to - from) * Double(offsets.count - 1)
+    let index = min(Int(cursor), offsets.count - 2)
+    return offsets[index] + (offsets[index + 1] - offsets[index]) * CGFloat(cursor - Double(index))
+  }
+
+  public func glow(at time: Double, lineEnd: Double) -> CGFloat {
+    guard timed, time > from else { return 0 }
+    let rise = max(0.001, to - from) * 1.18
+    let peak = from + rise
+    let tail = max(peak + 0.18, lineEnd, to + 1.05)
+    let value = time <= peak ? (time - from) / rise : 1 - (time - peak) / (tail - peak)
+    let p = min(1, max(0, value))
+    return CGFloat(p * p * (3 - 2 * p)) * 0.88
+  }
+}
+
+public struct BiuMonetMetrics {
+  public let line: BiuMonetLine
+  public let font: UIFont
+  public let words: [BiuMonetWord]
+  public let width: CGFloat
+
+  public init(line: BiuMonetLine, fontSize: CGFloat) {
+    self.line = line
+    font = UIFont.systemFont(ofSize: fontSize, weight: .semibold)
+    let graphemes = Array(line.text)
+    let ranges = line.words.isEmpty ? [[Double(graphemes.count), line.from, line.to]] : line.words
+    var start = 0
+    var x: CGFloat = 0
+    var result: [BiuMonetWord] = []
+    for range in ranges where range.count >= 3 {
+      let end = min(graphemes.count, max(start, Int(range[0])))
+      guard end > start else { continue }
+      let text = String(graphemes[start..<end])
+      var prefix = ""
+      var offsets: [CGFloat] = [0]
+      for character in text {
+        prefix.append(character)
+        offsets.append((prefix as NSString).size(withAttributes: [.font: font]).width)
+      }
+      let width = offsets.last ?? 0
+      let timingValues = Array(range.dropFirst(3))
+      var timings: [(from: Double, to: Double)] = []
+      if timingValues.count == (end - start) * 2 {
+        for index in stride(from: 0, to: timingValues.count, by: 2) {
+          timings.append((from: timingValues[index], to: timingValues[index + 1]))
+        }
+      }
+      result.append(BiuMonetWord(text: text, x: x, width: width, offsets: offsets,
+        graphemeTimings: timings, from: range[1], to: range[2]))
+      x += width
+      start = end
+    }
+    words = result
+    width = x
+  }
+
+  public var edge: CGFloat { min(16, max(6, font.pointSize * 0.45)) }
+
+  public func scroll(at time: Double, viewport: CGFloat) -> CGFloat {
+    // Untimed punctuation does not consume singing time or leave the ending hidden.
+    let front = time >= line.to ? width : words.reduce(CGFloat(0)) { front, word in
+      word.timed && time >= word.from ? max(front, word.x + word.filledWidth(at: time)) : front
+    }
+    return min(max(0, width - viewport), max(0, front - viewport * 0.60))
+  }
+
+  public func draw(in context: CGContext, origin: CGPoint, time: Double, focused: Bool) {
+    for word in words {
+      let point = CGPoint(x: origin.x + word.x, y: origin.y)
+      let rect = CGRect(x: point.x, y: point.y, width: word.width, height: font.lineHeight)
+      if !context.boundingBoxOfClipPath.intersects(rect.insetBy(dx: -font.pointSize, dy: -font.pointSize)) { continue }
+      let attributes: [NSAttributedString.Key: Any] = [.font: font, .foregroundColor: BiuMonetPalette.primary]
+      let glow = focused ? word.glow(at: time, lineEnd: line.to) : 0
+      if glow > 0.001 {
+        context.saveGState()
+        context.beginTransparencyLayer(auxiliaryInfo: nil)
+        for radius in [round(font.pointSize * 0.65), round(font.pointSize * 0.28)] {
+          context.setShadow(offset: .zero, blur: radius,
+                            color: BiuMonetPalette.primary.withAlphaComponent(glow).cgColor)
+          (word.text as NSString).draw(at: point, withAttributes: attributes)
+        }
+        context.setShadow(offset: .zero, blur: 0, color: nil)
+        context.saveGState()
+        context.setBlendMode(.clear)
+        (word.text as NSString).draw(at: point, withAttributes: attributes)
+        context.restoreGState()
+        context.endTransparencyLayer()
+        context.restoreGState()
+      }
+      (word.text as NSString).draw(at: point, withAttributes: [
+        .font: font, .foregroundColor: BiuMonetPalette.primary.withAlphaComponent(
+          focused ? (word.timed && time > word.to ? 0.98 : 0.34) : 0.46)
+      ])
+      guard focused, word.timed else { continue }
+      let filled = word.filledWidth(at: time)
+      guard filled > 0 else { continue }
+      let sweep = filled + edge * min(1, filled / max(1, word.width))
+      guard let glyph = BiuMonetGlyphs.image(word.text, font: font) else { continue }
+      context.saveGState()
+      context.translateBy(x: point.x, y: point.y + font.lineHeight)
+      context.scaleBy(x: 1, y: -1)
+      context.clip(to: CGRect(x: 0, y: 0, width: word.width, height: font.lineHeight), mask: glyph)
+      context.beginTransparencyLayer(auxiliaryInfo: nil)
+      if let fill = CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: [
+        BiuMonetPalette.primary.cgColor,
+        BiuMonetPalette.primary.withAlphaComponent(0.92).cgColor,
+        BiuMonetPalette.primary.withAlphaComponent(0.72).cgColor
+      ] as CFArray, locations: [0, 0.68, 1]) {
+        context.drawLinearGradient(fill, start: .zero, end: CGPoint(x: word.width, y: 0), options: [])
+      }
+      context.setBlendMode(.destinationIn)
+      if let mask = CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: [
+        UIColor.white.cgColor, UIColor.white.cgColor,
+        UIColor.white.withAlphaComponent(0.92).cgColor, UIColor.clear.cgColor
+      ] as CFArray, locations: [0, max(0, sweep - edge) / sweep,
+        max(0, sweep - edge * 0.55) / sweep, 1]) {
+        context.drawLinearGradient(mask, start: .zero, end: CGPoint(x: sweep, y: 0),
+          options: [.drawsAfterEndLocation])
+      }
+      context.endTransparencyLayer()
+      context.restoreGState()
+    }
+  }
+}
