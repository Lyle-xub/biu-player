+// The full lyric timeline lives in the app, never in ActivityKit's 4 KB state.
+// AVPlayer's native periodic observer continues when React's JS thread is busy.
+@available(iOS 16.2, *)
+@MainActor
+final class BiuLyricsActivityClock {
+  static let shared = BiuLyricsActivityClock()
+  private var observer: NSObjectProtocol?
+  private var activityID: String?
+  private var base: [String: Any] = [:]
+  private var lines: [[String: Any]] = []
+  private var mediaKey = ""
+  private var audioOffset = 0.0
+  private var previousSample: (position: Double, date: Double, playing: Bool)?
+  private var clockAnchor: Double?
+  private var lastBoundary = ""
+  private var lastPublished = 0.0
+  private var seekRevision = 0
+  private var pending: String?
+  private var submission: Task<Void, Never>?
+
+  nonisolated static func snapshot(_ props: String) -> String {
+    guard let data = props.data(using: .utf8),
+          var value = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return props }
+    for key in ["_timeline", "_mediaKey", "_audioOffset"] { value.removeValue(forKey: key) }
+    return encode(value) ?? "{}"
+  }
+
+  nonisolated private static func encode(_ value: [String: Any]) -> String? {
+    var value = value
+    if let slots = value["slots"] as? [Any] {
+      value["slots"] = slots.map { entry -> Any in
+        guard var line = entry as? [String: Any] else { return entry }
+        // The system timer needs line timing only; detailed glyph timing stays
+        // in the app/PiP instead of consuming ActivityKit's limited state size.
+        line["words"] = [] as [Int]
+        return line
+      }
+    }
+    guard JSONSerialization.isValidJSONObject(value),
+          let data = try? JSONSerialization.data(withJSONObject: value) else { return nil }
+    return String(data: data, encoding: .utf8)
+  }
+
+  private init() {
+    observer = NotificationCenter.default.addObserver(
+      forName: Notification.Name("BiuPlayerPlaybackClock"), object: nil, queue: .main
+    ) { [weak self] notification in
+      // The notification is emitted on main by VideoPlayerObserver.
+      MainActor.assumeIsolated { self?.receive(notification.userInfo ?? [:]) }
+    }
+  }
+
+  func configure(id: String, props: String) {
+    guard let data = props.data(using: .utf8),
+          var value = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return }
+    if activityID != id { stop(); activityID = id }
+    lines = value.removeValue(forKey: "_timeline") as? [[String: Any]] ?? []
+    mediaKey = value.removeValue(forKey: "_mediaKey") as? String ?? ""
+    audioOffset = value.removeValue(forKey: "_audioOffset") as? Double ?? 0
+    base = value
+    previousSample = nil
+    clockAnchor = nil
+    if let date = value["updatedAt"] as? Double, let position = value["position"] as? Double {
+      value["clockAnchor"] = date - position
+    }
+    lastBoundary = ""
+    lastPublished = 0
+    seekRevision = 0
+    enqueue(Self.encode(value))
+  }
+
+  func stop(id: String? = nil) {
+    guard id == nil || id == activityID else { return }
+    activityID = nil
+    pending = nil
+    submission?.cancel()
+    submission = nil
+    lines = []
+    base = [:]
+    previousSample = nil
+  }
+
+  private func receive(_ sample: [AnyHashable: Any]) {
+    guard activityID != nil, sample["mediaKey"] as? String == mediaKey,
+          let position = sample["position"] as? Double, position.isFinite,
+          let date = sample["updatedAt"] as? Double, date.isFinite else { return }
+    let playing = sample["playing"] as? Bool ?? false
+    if let previousSample {
+      let expected = previousSample.position + (previousSample.playing ? date - previousSample.date : 0)
+      if abs(position - expected) > 0.75 {
+        seekRevision += 1
+        clockAnchor = nil
+      }
+      if playing != previousSample.playing { clockAnchor = nil }
+    }
+    previousSample = (position, date, playing)
+    let time = position + audioOffset
+    if clockAnchor == nil { clockAnchor = date - time }
+    var index = 0
+    while index + 1 < lines.count, time >= (lines[index + 1]["from"] as? Double ?? 0) { index += 1 }
+    // Long lines need position snapshots to select a whole visible page.
+    // The view hard-cuts only when the page changes; it never animates offsets.
+    var started = false
+    var completed = false
+    var paginating = false
+    if !lines.isEmpty {
+      let from = lines[index]["from"] as? Double ?? 0
+      let to = lines[index]["to"] as? Double ?? from
+      started = time >= from
+      completed = time >= to
+      paginating = (lines[index]["text"] as? String ?? "").count > 4 && started && !completed
+    }
+    let boundary = "\(index):\(started):\(completed):\(playing):\(seekRevision)"
+    guard boundary != lastBoundary || (playing && paginating && date - lastPublished >= 0.45) else { return }
+    lastBoundary = boundary
+    lastPublished = date
+    var slots: [Any] = [NSNull(), NSNull()]
+    if !lines.isEmpty {
+      slots[index % 2] = lines[index]
+      if index + 1 < lines.count { slots[1 - index % 2] = lines[index + 1] }
+    }
+    var value = base
+    value["slots"] = slots
+    value["activeSlot"] = index % 2
+    value["previousLyric"] = index > 0 ? lines[index - 1]["text"] : nil
+    value["position"] = time
+    value["updatedAt"] = date
+    value["playing"] = playing
+    value["clockAnchor"] = clockAnchor
+    value["clockRevision"] = "\(base["clockRevision"] as? String ?? ""):\(seekRevision)"
+    enqueue(Self.encode(value))
+  }
+
+  private func enqueue(_ props: String?) {
+    pending = props
+    guard submission == nil, let id = activityID else { return }
+    submission = Task { [weak self] in
+      guard let self else { return }
+      // Keep only the newest snapshot while ActivityKit processes an update.
+      while !Task.isCancelled, self.activityID == id, let props = self.pending {
+        self.pending = nil
+        guard let activity = Activity<LiveActivityAttributes>.activities.first(where: {
+          $0.id == id && ($0.activityState == .active || $0.activityState == .stale)
+        }) else { self.stop(id: id); return }
+        let state = LiveActivityAttributes.ContentState(name: "LyricsLiveActivity", props: props)
+        await activity.update(ActivityContent(state: state, staleDate: nil))
+      }
+      if !Task.isCancelled { self.submission = nil }
+    }
+  }
+}
