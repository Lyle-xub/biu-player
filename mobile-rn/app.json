{
  "expo": {
    "name": "Biu Player",
    "slug": "biu-player-mobile",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0d09",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biuplayer.mobile",
      "buildNumber": "20",
      "appleTeamId": "GXVN75MDQN"
    },
    "android": {
      "package": "com.biuplayer.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0d09",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0b0d09",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-image",
      "expo-sharing",
      "./plugins/withLanSync",
      "./plugins/withSceneLifecycle",
      "expo-asset",
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      "expo-secure-store",
      "./plugins/withBiuLyricsWidgets",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.biuplayer.mobile.widgets",
          "groupIdentifier": "group.com.biuplayer.mobile",
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "LyricsWidget",
              "displayName": "Biu 桌面歌词",
              "description": "显示当前播放歌曲与歌词",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemMedium",
                "accessoryRectangular"
              ]
            }
          ]
        }
      ]
    ],
    "scheme": "biu-player"
  }
}
